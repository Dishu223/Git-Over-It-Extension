{
  "manifest_version": 3,
  "name": "Git Over It",
  "version": "1.0.0",
  "description": "Automatically push your accepted LeetCode solutions to GitHub.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Git Over It"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content.ts"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inject.ts"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
